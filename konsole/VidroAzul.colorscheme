# Esquema de cores do Konsole: Breeze com fundo azul-marinho de vidro.
# Em relação ao Breeze, o texto fraco (dim) foi escurecido para se distinguir
# do texto normal, e vermelho, magenta, ciano e algumas versões intensas e
# fracas foram clareados para manter o contraste sobre o azul-marinho.
# Cores no formato vermelho,verde,azul (0 a 255).

[General]
Description=Vidro Azul
# 1.0 = opaco, 0.0 = invisível
Opacity=0.75
# Desfoque atrás da janela (efeito vidro)
Blur=true
ColorRandomization=false
Wallpaper=

